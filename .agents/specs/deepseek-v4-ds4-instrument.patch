+/* DS4_DUMP_ACT: env-gated per-layer activation dump (coherence-debug #188).
+ * Writes a raw little-endian float32 vector to $DS4_DUMP_ACT/<name>.bin. */
+static void ds4_dump_act(const char *name, const float *v, uint64_t n) {
+    const char *dir = getenv("DS4_DUMP_ACT");
+    if (!dir || !name) return;
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/%s.bin", dir, name);
+    FILE *f = fopen(path, "wb");
+    if (f) { fwrite(v, sizeof(float), (size_t)n, f); fclose(f); }
+}
