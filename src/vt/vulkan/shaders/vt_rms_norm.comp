#version 450
// vt::RmsNorm, including the in-place residual stream. Math ported 1:1 from
// src/vt/cpu/cpu_ops.cpp:225-250 RmsNormKernel — the residual idiom is
// reproduced EXACTLY, including the deliberate store-then-round that makes a
// bf16 residual stream bit-faithful (cpu_ops.cpp:235-237): add in f32, round
// into the residual's OWN dtype, then use the ROUNDED value for both the
// variance and the scale.
//
// Dispatch shape (one workgroup per row + shared-memory tree reduction) from
// llama.cpp `vulkan-shaders/rms_norm.comp:37-83` @ 237ad9b96. Note the scale is
// `1.0 / sqrt(...)`, NOT llama.cpp's `inversesqrt` (rms_norm.comp:86) — see
// vt_common.glsl § DELIBERATE DIVERGENCES.
//
// THIS IS THE 128-WIDE, SUBGROUP-FREE FALLBACK. 128 invocations and a plain
// shared-memory halving tree are what EVERY conformant Vulkan 1.1 device
// guarantees, so this module is always loadable. The host prefers
// vt_rms_norm_wide.comp where the device allows it; see that file for the
// measurement that made a second module worth having.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

#include "vt_rms_norm_body.glsl"
