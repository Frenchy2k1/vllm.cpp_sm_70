#!/usr/bin/env bash
# Run record and public-document gates against the COMMITS BEING PUSHED.
#
# Why this exists: docs/STATUS.md carries a shrink-only size ratchet and
# docs/BENCHMARKS.md a per-cell budget, and both are enforced only in CI. A
# landing that overshoots them turns main red for whoever pushes next, which is
# the expensive moment to find out. scripts/agent-preflight.sh already runs
# these two checkers, but it is opt-in and a forgotten run is exactly how
# 8f752ae5 reached main over both limits.
#
# It checks the PUSHED COMMIT's worktree, not the caller's working tree:
# a dirty checkout must not fail a clean push, and an uncommitted fix must not
# let a broken commit through. This is the same content CI will see.
#
# Enable (once per clone):   git config core.hooksPath .githooks
# Bypass a single push:      git push --no-verify
#
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'

# The checkers and the paths they read. Keep both lists in sync with
# scripts/agent-preflight.sh's CHECKERS entries for the same two gates.
CHECKERS=(check-policy.py check-prompt-contract.py check-state-record.py check-now-current.py check-readme-structure.py check-public-doc-tables.py)

shas=()
bases=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A branch deletion pushes the null sha and has no tree to check.
  [ "$local_sha" = "$ZERO" ] && continue
  [ -z "$local_sha" ] && continue
  shas+=("$local_sha")
  bases+=("$remote_sha")
done

# Nothing on stdin (a hand-run, or a git that passed no refs): check HEAD.
if [ ${#shas[@]} -eq 0 ]; then
  shas=("$(git rev-parse HEAD)")
  bases=("$(git rev-parse HEAD^)")
fi

tmp="$(mktemp -d)"
worktrees=()
cleanup() {
  for worktree in "${worktrees[@]}"; do
    git -C "$ROOT" worktree remove --force "$worktree" >/dev/null 2>&1 || true
  done
  rm -rf "$tmp"
}
trap cleanup EXIT

failed=0
for index in "${!shas[@]}"; do
  sha="${shas[$index]}"
  base="${bases[$index]}"
  if [ "$base" = "$ZERO" ] || ! git -C "$ROOT" cat-file -e "${base}^{commit}" 2>/dev/null; then
    base="$(git -C "$ROOT" merge-base origin/main "$sha" 2>/dev/null || git -C "$ROOT" rev-parse "$sha^" 2>/dev/null || true)"
  fi
  work="$tmp/${sha}"
  if ! git -C "$ROOT" worktree add --quiet --detach "$work" "$sha" 2>"$tmp/.worktree-err"; then
    printf 'pre-push: could not materialize %s for checking\n' "${sha:0:12}" >&2
    sed 's/^/  /' "$tmp/.worktree-err" >&2
    failed=1
    continue
  fi
  worktrees+=("$work")
  if [ -z "$base" ]; then
    printf 'pre-push: could not resolve comparison base for %s\n' "${sha:0:12}" >&2
    failed=1
    continue
  fi
  for checker in "${CHECKERS[@]}"; do
    [ -f "$work/scripts/$checker" ] || continue
    args=()
    case "$checker" in
      check-state-record.py) args=(--base "$base") ;;
      check-now-current.py) args=(--base "$base" --head "$sha") ;;
    esac
    if ! output="$(cd "$work" && python3 "scripts/$checker" "${args[@]}" 2>&1)"; then
      printf 'pre-push: %s FAILED on %s\n' "$checker" "${sha:0:12}" >&2
      printf '%s\n' "$output" | sed 's/^/  /' >&2
      failed=1
    fi
  done
  git -C "$ROOT" worktree remove --force "$work" >/dev/null 2>&1 || true
done

if [ "$failed" -ne 0 ]; then
  cat >&2 <<'MSG'

pre-push: refusing to push. Fix the record or pages and amend, or re-run with
--no-verify if you are deliberately pushing over the budget.
MSG
  exit 1
fi

exit 0
